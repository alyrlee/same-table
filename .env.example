# ─── USDA FoodData Central ───
# Register free at: https://fdc.nal.usda.gov/api-key-signup/
USDA_API_KEY=DEMO_KEY

# ─── Nutritionix ───
# Register free at: https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# ─── HuggingFace (CLIP model) ───
# Register free at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# ─── Auth ───
JWT_SECRET=change-this-to-a-random-string
SESSION_SECRET=change-this-to-another-random-string

# ─── Server ───
PORT=3001
NODE_ENV=development
